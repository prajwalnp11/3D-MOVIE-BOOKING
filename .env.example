# Production Environment Configuration
# Copy this to .env on your server and update the values

# Generate a new secret key for production
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters

# Set to False in production
DEBUG=False

# Comma-separated list of domain names or server IP addresses
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-server-ip,localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF (e.g. https://yourdomain.com)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://your-server-ip

# The Movie Database (TMDB) API Key
TMDB_API_KEY=f3e8ee1ab3840fe7b0486eec9594df13
